            {
              "id": "c1000000-00b1-4b6c-9d7e-8f9a0b1c2d3e",
              "leftValue": "={{ $json.pin_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
