    {
      "parameters": {
        "jsCode": "const req = $('Validate input').first().json;\nconst row = $input.first().json; // {} when nothing matched\nconst found = !!row.row_number && String(row.InviteCode ?? '').trim().toUpperCase() === req.code;\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\n\nlet out = { status: 'not_found', update: false };\n\nif (found) {\n  const used = String(row.InviteUsed ?? '').toLowerCase() === 'yes';\n  const base = {\n    name: row.Name ?? '',\n    goal: row['Your Goal'] ?? '',\n    row_number: row.row_number,\n    usedAt: row.UsedAt ?? '',\n  };\n\n  if (used) {\n    out = { ...base, status: 'used', update: false };\n  } else {\n    out = { ...base, status: 'ok', usedAt: now, update: true, newStage: 'visited', newUsed: 'yes', newUsedAt: now };\n  }\n}\n\nreturn [{ json: out }];"
      },
      "type": "n8n-nodes-base.code",
