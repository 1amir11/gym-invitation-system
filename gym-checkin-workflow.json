    {
      "parameters": {
        "jsCode": "// Set your own staff PIN (6+ digits). The staff page asks for it.\n// While it is still CHANGE_ME, every request is rejected.\nconst STAFF_PIN = 'CHANGE_ME';\n\nconst b = $input.first().json.body ?? {};\nconst pinOk = STAFF_PIN !== 'CHANGE_ME' && String(b.pin ?? '') === STAFF_PIN;\nconst code = String(b.code ?? '').trim().toUpperCase().slice(0, 30);\n\nreturn [{\n  json: {\n    pin_ok: pinOk,\n    // An empty lookup value could match rows with an empty InviteCode, so never search for ''.\n    code: code || '__NONE__',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ],
      "id": "c1000000-0002-4a5b-8c6d-7e8f9a0b1c2d",
