    {
      "parameters": {
        "jsCode": "const toLatin = s => String(s ?? '')\n  .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d))\n  .replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));\n\nreturn $input.all().map(item => {\n  const b = item.json.body ?? {};\n  const name = String(b.name ?? '').trim().slice(0, 80);\n  const goal = String(b.goal ?? '').trim().slice(0, 60);\n  const raw = String(b.phone ?? '');\n\n  let d = toLatin(raw).replace(/\\D/g, '');\n  if (d.startsWith('00')) d = d.slice(2);                          // 0020...\n  if (d.startsWith('0') && d.length === 11) d = '20' + d.slice(1); // 01012345678\n  else if (d.startsWith('1') && d.length === 10) d = '20' + d;     // leading zero was lost\n\n  const phoneOk = /^201[0125]\\d{8}$/.test(d);\n  let error = '';\n  if (!phoneOk) error = 'invalid_phone';\n  else if (!name) error = 'missing_name';\n\n  return {\n    json: {\n      name,\n      goal,\n      consent: b.consent === 'yes' ? 'yes' : 'no',\n      phone: d,\n      valid: error === '',\n      error,\n    },\n  };\n});"
      },
